# Agent Bridge local configuration. Do not put tokens here.
BRIDGE_AUTO_MERGE=false
BRIDGE_DRY_RUN=true
BRIDGE_MAX_TASKS=3
BRIDGE_MAX_REPAIR_CYCLES=2
BRIDGE_MAX_TASK_MINUTES=90
BRIDGE_POLL_SECONDS=30
# Bounded batch is sequential only. Real batch execution is not yet authorized.
BRIDGE_BATCH_MAX_TASKS=2
BRIDGE_BATCH_MAX_MINUTES=180
